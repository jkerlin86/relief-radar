# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Data: raw and processed data are never committed (see data/README.md).
# Download scripts reproduce them from the CFPB and the SEC.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Model artifacts and caches are built by the pipeline scripts
models/*
!models/.gitkeep
.cache/

# Generated outputs (regenerated by scripts/run_all.sh)
reports/*.json
figures/*.png

# OS / editor
.DS_Store
.idea/
.vscode/
